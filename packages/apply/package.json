{
  "name": "@opencampingdb/apply",
  "version": "0.1.0",
  "private": true,
  "description": "Applies Open Camping DB feedback from the inbox repository to a checkout of the data repository.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./decide": {
      "types": "./dist/decide.d.ts",
      "default": "./dist/decide.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "default": "./dist/review.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./progress-update": {
      "types": "./dist/progress-update.d.ts",
      "default": "./dist/progress-update.js"
    }
  },
  "bin": {
    "ocdb-apply": "./dist/cli.js",
    "ocdb-photos": "./dist/photos-cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "apply": "node dist/cli.js"
  },
  "dependencies": {
    "@opencampingdb/feedback": "0.27.0"
  }
}
